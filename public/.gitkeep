:root {
  font-family: Inter, 'Segoe UI', sans-serif;
  color: #eaf2ff;
  background: #081120;
  line-height: 1.5;
  font-weight: 400;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  --bg: #081120;
  --panel: rgba(15, 25, 42, 0.92);
  --panel-strong: #101d31;
  --primary: #7fd5ff;
  --primary-dark: #4aa2d6;
  --accent: #7ef0c5;
  --muted: #a6b5d1;
  --line: rgba(160, 183, 221, 0.2);
  --shadow: 0 20px 50px rgba(3, 8, 14, 0.35);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-height: 100vh;
  background:
    radial-gradient(circle at top, rgba(80, 129, 255, 0.2), transparent 30%),
    linear-gradient(135deg, #050d19 0%, #0b1528 100%);
  color: #eaf2ff;
}

button,
input,
select {
  font: inherit;
}

#root {
  min-height: 100vh;
}

.app-shell {
  max-width: 1200px;
  margin: 0 auto;
  padding: 32px 20px 48px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 32px;
}

.brand-wrap {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-mark {
  display: grid;
  place-items: center;
  width: 46px;
  height: 46px;
  border-radius: 14px;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  color: #071423;
  font-size: 1.4rem;
  font-weight: 800;
  box-shadow: var(--shadow);
}

.eyebrow {
  margin: 0;
  color: var(--muted);
  text-transform: uppercase;
  font-size: 0.7rem;
  letter-spacing: 0.12em;
}

.eyebrow.dark {
  color: var(--primary-dark);
}

h1,
h2,
h3,
h4,
p {
  margin-top: 0;
}

h1 {
  margin-bottom: 0;
  font-size: 1.6rem;
}

.nav {
  display: flex;
  align-items: center;
  gap: 18px;
}

.nav a {
  color: var(--muted);
  text-decoration: none;
}

.primary-btn,
.search-btn,
.filter-btn,
.flight-meta button {
  border: none;
  border-radius: 12px;
  cursor: pointer;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.primary-btn,
.search-btn,
.flight-meta button {
  background: linear-gradient(135deg, var(--primary), var(--accent));
  color: #081120;
  font-weight: 700;
}

.primary-btn {
  padding: 0.85rem 1.2rem;
}

.hero {
  display: grid;
  grid-template-columns: 1.1fr 1.3fr;
  gap: 24px;
  margin-bottom: 26px;
}

.hero-copy,
.search-panel,
.stat-card,
.flight-card {
  background: rgba(9, 18, 28, 0.7);
  border: 1px solid var(--line);
  border-radius: 24px;
  box-shadow: var(--shadow);
}

.hero-copy {
  padding: 34px 30px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.hero-copy h2 {
  font-size: clamp(2.1rem, 4vw, 3.2rem);
  line-height: 1.1;
  margin-bottom: 12px;
}

.subtext {
  color: var(--muted);
  font-size: 1.05rem;
  max-width: 50ch;
}

.search-panel {
  padding: 20px;
}

.field-row {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 12px;
  margin-bottom: 16px;
}

.field-row.compact {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  color: var(--muted);
  font-size: 0.8rem;
  font-weight: 600;
}

input,
select {
  width: 100%;
  border: 1px solid var(--line);
  background: rgba(12, 20, 31, 0.9);
  border-radius: 12px;
  color: #edf5ff;
  padding: 0.8rem 0.9rem;
}

.swap-btn {
  align-self: end;
  width: 42px;
  height: 42px;
  margin-bottom: 0.15rem;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: rgba(127, 213, 255, 0.14);
  color: var(--primary);
  font-size: 1.2rem;
}

.search-btn {
  width: 100%;
  padding: 0.9rem 1.2rem;
  margin-top: 6px;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
  margin-bottom: 24px;
}

.stat-card {
  padding: 20px 22px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.stat-card span {
  color: var(--muted);
}

.stat-card strong {
  font-size: clamp(1.5rem, 2vw, 2rem);
}

.results-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  margin-bottom: 18px;
}

.results-header h3 {
  margin-bottom: 0;
  font-size: 1.8rem;
}

.filter-btn {
  background: rgba(127, 213, 255, 0.08);
  color: var(--primary);
  border: 1px solid var(--line);
  padding: 0.7rem 1rem;
}

.flight-list {
  display: grid;
  gap: 18px;
}

.flight-card {
  padding: 20px 22px;
}

.flight-topline,
.flight-meta,
.flight-route {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.flight-topline {
  margin-bottom: 18px;
}

.badge {
  display: inline-flex;
  align-items: center;
  border-radius: 999px;
  background: rgba(126, 240, 197, 0.1);
  border: 1px solid rgba(126, 240, 197, 0.3);
  color: var(--accent);
  padding: 0.35rem 0.7rem;
  font-size: 0.75rem;
  font-weight: 700;
  margin-bottom: 8px;
}

.flight-topline h4 {
  margin-bottom: 0;
  font-size: 1.4rem;
}

.price-block {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.price-block span,
.flight-meta span,
.route-line span,
.time-box span {
  color: var(--muted);
}

.price-block strong {
  font-size: 2rem;
}

.flight-route {
  margin-bottom: 16px;
}

.time-box {
  min-width: 140px;
}

.time-box strong {
  display: block;
  font-size: 1.8rem;
}

.route-line {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12px;
  color: var(--primary);
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.line {
  flex: 1;
  height: 2px;
  background: linear-gradient(90deg, rgba(127, 213, 255, 0.2), rgba(127, 213, 255, 1), rgba(127, 213, 255, 0.2));
  min-width: 80px;
}

.flight-meta {
  padding-top: 14px;
  border-top: 1px solid var(--line);
}

.flight-meta button {
  padding: 0.75rem 1.2rem;
}

button:hover {
  opacity: 0.96;
  transform: translateY(-1px);
}

@media (max-width: 840px) {
  .hero {
    grid-template-columns: 1fr;
  }

  .field-row,
  .field-row.compact,
  .stats-grid,
  .flight-route,
  .flight-topline,
  .flight-meta,
  .topbar {
    grid-template-columns: 1fr;
    display: grid;
  }

  .topbar,
  .flight-topline,
  .flight-meta {
    justify-content: stretch;
  }

  .nav {
    display: none;
  }

  .price-block {
    align-items: flex-start;
  }
}
